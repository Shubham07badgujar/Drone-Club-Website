# Production Environment Configuration for Frontend
# Set these values in Render's Environment Variables section

# Backend API URL (Update with your Render backend URL)
VITE_API_URL=https://your-backend-app.onrender.com

# App Configuration
VITE_APP_TITLE=Team Third Axis - Drone Club
VITE_APP_NAME=Drone Club Website
VITE_APP_VERSION=1.0.0

# Environment
VITE_NODE_ENV=production

# Optional Analytics (if using)
# VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Feature Flags
VITE_ENABLE_DEBUG_MODE=false
VITE_ENABLE_BETA_FEATURES=false
