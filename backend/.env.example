# Environment Configuration
NODE_ENV=development
PORT=5000

# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/<database-name>?retryWrites=true&w=majority

# Alternative environment variable name
MONGODB_ATLAS_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/<database-name>?retryWrites=true&w=majority

# Legacy Database Configuration (for reference only)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=drone_club_db
# DB_USER=your_username
# DB_PASSWORD=your_password

# JWT Configuration
JWT_SECRET=your_very_secure_jwt_secret_key_here
JWT_EXPIRE=7d

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# CORS Configuration
FRONTEND_URL=http://localhost:3000

# Example MongoDB Atlas URI format:
# mongodb+srv://droneclub:mypassword@droneclub.abcdef.mongodb.net/droneclub_db?retryWrites=true&w=majority

# To get your MongoDB Atlas URI:
# 1. Go to https://cloud.mongodb.com/
# 2. Create an account or sign in
# 3. Create a new cluster (free tier available)
# 4. Go to "Database Access" and create a database user
# 5. Go to "Network Access" and add your IP address (or 0.0.0.0/0 for anywhere)
# 6. Go to "Clusters" and click "Connect"
# 7. Choose "Connect your application"
# 8. Copy the connection string and replace <password> with your database user password
